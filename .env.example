# Lather Bros — Firebase credentials
# Copy this file to .env.local and replace every placeholder with real values.
# Restart the dev server after changing credentials.

# ---------------------------------------------------------------------------
# Web app config (Firebase Console > Project settings > General > Your apps)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-me
NEXT_PUBLIC_FIREBASE_APP_ID=replace-me
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=replace-me

# ---------------------------------------------------------------------------
# Admin SDK (Firebase Console > Project settings > Service accounts)
# Generate a new private key and paste the fields here.
# The form writes to the `cleaningRequests` Firestore collection using these.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Gmail (Google Account > Security > 2-Step Verification > App passwords)
# The form emails the team on each request, and the customer if they left an email.
# Use the Gmail address and a 16-character app password, not your normal login.
# GMAIL_TO can be the same inbox, or a comma-separated list.
# ---------------------------------------------------------------------------
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=replace-me-app-password
GMAIL_FROM_NAME=Lather Bros
GMAIL_TO=you@gmail.com
